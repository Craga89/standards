{
  "name": "@craga89/standards",
  "version": "1.0.0",
  "description": "Shared engineering standards: GitHub Actions, oxlint/oxfmt/TypeScript configs and coding guidelines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craga89/standards.git"
  },
  "files": [
    "configs"
  ],
  "type": "module",
  "exports": {
    "./oxlint/*": "./configs/oxlint/*.json",
    "./oxfmt": "./configs/oxfmt/base.json",
    "./tsconfig/*": "./configs/tsconfig/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --disable-nested-config"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
