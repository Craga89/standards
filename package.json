{
  "name": "@craga89/standards",
  "version": "1.0.1",
  "description": "Shared oxlint, oxfmt and tsconfig presets. Use it as a pnpm config dependency.",
  "keywords": [
    "config-dependency",
    "oxfmt",
    "oxlint",
    "pnpm",
    "tsconfig"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craga89/standards.git"
  },
  "files": [
    "configs"
  ],
  "type": "module",
  "exports": {
    "./oxlint/*": "./configs/oxlint/*.json",
    "./oxfmt": "./configs/oxfmt/base.json",
    "./tsconfig/*": "./configs/tsconfig/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "test:unit": "node --test \"tests/**/*.test.mjs\"",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run test:unit"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "packageManager": "pnpm@12.15.0"
}
