{
  "name": "@craga89/standards",
  "version": "1.0.0",
  "description": "Shared GitHub Actions, oxlint/oxfmt/tsconfig presets and coding guidelines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Craga89/standards.git"
  },
  "files": [
    "configs"
  ],
  "type": "module",
  "exports": {
    "./oxlint/*": "./configs/oxlint/*.json",
    "./oxfmt": "./configs/oxfmt/base.json",
    "./tsconfig/*": "./configs/tsconfig/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:unit": "node --test \"tests/**/*.test.mjs\"",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run test:unit"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0"
}
